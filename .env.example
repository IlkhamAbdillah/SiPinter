# Copy to `.env` in the repository root. Read by the Express API (apps/api)
# and its database scripts. Placeholders only: never commit real values.

# ---------- API ----------
NODE_ENV=development
PORT=4000

# Comma-separated browser origins allowed to call the API directly (CORS).
# Leave empty when the browser reaches the API through the same origin
# (the Next.js /api rewrite in development, Nginx in production).
CORS_ORIGINS=

# Public origin of the web app as the browser sees it. POST/PUT/PATCH/DELETE
# requests from any other Origin are rejected (CSRF defence). Required in production.
APP_ORIGIN=http://localhost:3000

# Login sessions expire this many hours after login (absolute, no sliding renewal).
SESSION_TTL_HOURS=12

# ---------- Database ----------
# Local development (docker-compose.dev.yml, host port DEV_DB_PORT, default 5433):
DATABASE_URL=postgres://sipinter:sipinter_dev_password@localhost:5433/sipinter
DATABASE_SSL=disable
#
# AWS RDS (use the least-privilege app user, not the master user; do not put sslmode in the URL):
# DATABASE_URL=postgres://sipinter_app:<password>@<instance>.<id>.<region>.rds.amazonaws.com:5432/<database>
# DATABASE_SSL=verify-full
# DATABASE_SSL_CA_PATH=/etc/ssl/certs/rds-global-bundle.pem
DATABASE_POOL_MAX=10

# Disposable database for integration tests. Its name MUST end in `_test`;
# the tests wipe it. Comment out to skip database integration tests.
TEST_DATABASE_URL=postgres://sipinter:sipinter_dev_password@localhost:5433/sipinter_test

# ---------- Web (apps/web) ----------
# Server-side URL Next.js uses to reach the API. Defaults to http://localhost:4000.
# Set it in the environment or in apps/web/.env.local, not here (Next.js reads its own folder).
# API_INTERNAL_URL=http://localhost:4000
